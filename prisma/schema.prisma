generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Add to your existing schema.prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  orders              Order[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum UserRole {
  USER
  ADMIN
}

model Product {
  id          String          @id @default(cuid())
  title       String
  slug        String          @unique
  description String?         @db.Text
  price       Decimal         @db.Decimal(10, 2)
  imageUrl    String?
  category    ProductCategory
  tier        ProductTier     @default(COMMON)
  sku         String?         @unique
  inventory   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  orders      Order[]
  audits      ProductAudit[]

  @@index([slug])
  @@index([category])
  @@index([tier])
  @@index([isActive])
}

enum ProductCategory {
  BASEBALL
  BASKETBALL
  FOOTBALL
  HOCKEY
  SOCCER
  POKEMON
  YUGIOH
  MAGIC_THE_GATHERING
  ONE_PIECE
  DRAGON_BALL
  OTHER
}

enum ProductTier {
  COMMON
  UNCOMMON
  RARE
  ULTRA_RARE
  SECRET_RARE
  BANGER
  GRAIL
}

model Order {
  id              String       @id @default(cuid())

  packId          String
  packName        String
  amount          Int

  // Nullable until payment completes
  productId       String?
  product         Product?     @relation(fields: [productId], references: [id])

  // Nullable for guest checkout
  userId          String?
  user            User?        @relation(fields: [userId], references: [id])

  selectedTier    ProductTier?

  status          OrderStatus  @default(PENDING)

  stripeSessionId String?
  customerEmail   String?
  customerName    String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  audits          OrderAudit[]

  @@index([status])
  @@index([productId])
  @@index([userId])
  @@index([createdAt])
  @@index([customerEmail])
}

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Product Audit Trail
model ProductAudit {
  id          String            @id @default(cuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  action      ProductAction
  field       String?           // Which field changed (e.g., "price", "inventory")
  oldValue    String?           // Previous value (JSON string for complex values)
  newValue    String?           // New value
  metadata    Json?             // Additional context
  performedBy String?           // User/system that made the change
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime          @default(now())

  @@index([productId])
  @@index([action])
  @@index([createdAt])
  @@index([performedBy])
}

enum ProductAction {
  CREATED
  UPDATED
  DELETED
  INVENTORY_INCREASED
  INVENTORY_DECREASED
  PRICE_CHANGED
  STATUS_CHANGED
  TIER_CHANGED
}

// Order Audit Trail
model OrderAudit {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  action      OrderAction
  oldStatus   OrderStatus?
  newStatus   OrderStatus?
  metadata    Json?        // Additional context (stripe events, error messages, etc.)
  performedBy String?      // User/system that made the change
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime     @default(now())

  @@index([orderId])
  @@index([action])
  @@index([createdAt])
}

enum OrderAction {
  CREATED
  STATUS_CHANGED
  PAYMENT_INITIATED
  PAYMENT_COMPLETED
  PAYMENT_FAILED
  REFUND_INITIATED
  REFUND_COMPLETED
  PRODUCT_REVEALED
  PRODUCT_SHIPPED
  PRODUCT_DELIVERED
}